{
    "name": "dekor/php-impity",
    "description": "Impit for PHP: PSR-18 HTTP client for crawling, with real Chrome, Firefox and Safari TLS and HTTP/2 fingerprints, via curl-impersonate.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "http",
        "client",
        "psr-18",
        "guzzle",
        "impersonate",
        "tls",
        "ja3",
        "ja4",
        "fingerprint",
        "crawler",
        "scraping",
        "curl-impersonate"
    ],
    "authors": [
        {
            "name": "Denys Koronets",
            "email": "denys@linktrust.pro"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.5",
        "guzzlehttp/psr7": "^2.4",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "provide": {
        "psr/http-client-implementation": "1.0"
    },
    "autoload": {
        "psr-4": {
            "Dekor\\Impity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dekor\\Impity\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:offline": "phpunit --exclude-group network"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
